# [REQUIRED FOR FRONTEND] Stripe Publishable Key (Starts with 'pk_test_' or 'pk_live_')
# Direct link to copy: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_TYooMQauvdEDq54NiTphI7jx

# [OPTIONAL / BACKEND ONLY] Stripe Secret Key (Starts with 'sk_test_' or 'sk_live_')
# Note: Keep secret keys on backend or cloud functions, never commit real secret keys to public git.
VITE_STRIPE_SECRET_KEY=sk_test_dummy_key_to_pass_github_protection

# [SANDBOX / TEST MODE FLAG] Set to 'true' for test card testing, 'false' for live production
VITE_STRIPE_SANDBOX_MODE=true
